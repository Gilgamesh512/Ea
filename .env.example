# Wazuh
# Address of the Wazuh manager/API reachable from the n8n host.
WAZUH_MANAGER_IP=192.168.x.x
WAZUH_API_USER=your_wazuh_api_user
WAZUH_API_PASS=change_me

# DefectDojo
# If DefectDojo runs on the same Docker host but in a separate Compose project,
# use the published host address rather than the Docker service name.
DOJO_URL=http://host.docker.internal:8080
DOJO_API_KEY=your_defectdojo_api_key

# Ollama
# n8n reaches Ollama through the Docker host.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=your_model_name
