# ==============================================================================
# EA — SOAR & SECURITY OPERATIONS PLATFORM ENVIRONMENT TEMPLATE
# ==============================================================================
# HƯỚNG DẪN:
# 1. Tạo bản sao file này thành .env: Copy-Item .env.example .env (hoặc cp .env.example .env)
# 2. Điền các giá trị IP, API Key, Token và Mật khẩu phù hợp với hạ tầng lab của bạn.
# 3. KHÔNG BAO GIỜ commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PFSENSE NGFW & REST API SETTINGS
# ------------------------------------------------------------------------------
# Địa chỉ IP của pfSense WebGUI/API (mặc định trong lab: 192.168.2.1)
PFSENSE_IP=192.168.2.1
PFSENSE_PORT=443
# API Key được tạo từ pfSense package pfSense-pkg-RESTAPI
PFSENSE_API_KEY=YOUR_PFSENSE_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. N8N SOAR ORCHESTRATION ENGINE
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 3. OLLAMA LOCAL AI SETTINGS
# ------------------------------------------------------------------------------
# n8n kết nối đến Ollama qua địa chỉ host
OLLAMA_HOST=http://host.docker.internal:11434
# Mô hình AI đề xuất cho phân tích mối đe dọa (deepseek-r1:8b hoặc qwen2.5-coder:7b)
OLLAMA_MODEL=deepseek-r1:8b

# ------------------------------------------------------------------------------
# 4. DEFECTDOJO VULNERABILITY MANAGEMENT
# ------------------------------------------------------------------------------
# Thông tin tài khoản quản trị khởi tạo DefectDojo
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE
DD_ADMIN_MAIL=admin@ea.local
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=EA

# Các khóa bí mật bảo mật Django (tự tạo chuỗi ngẫu nhiên an toàn)
DD_SECRET_KEY=YOUR_SECURE_DJANGO_SECRET_KEY_HERE
DD_CREDENTIAL_AES_256_KEY=YOUR_32_CHAR_AES_KEY_HERE_123456

# Cấu hình Database Postgres nội bộ của DefectDojo
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# Địa chỉ & API Token để n8n kết nối đẩy finding vào DefectDojo
DOJO_URL=http://host.docker.internal:8080
DOJO_API_KEY=YOUR_DEFECTDOJO_API_KEY_HERE

# ------------------------------------------------------------------------------
# 5. GRAFANA LOKI & ALLOY LOGGING
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD_HERE
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_SYSLOG_UDP_PORT=1514

# ------------------------------------------------------------------------------
# 6. LAB VPN & REMOTE ACCESS (OPTIONAL / NẾU SỬ DỤNG)
# ------------------------------------------------------------------------------
DUCKDNS_DOMAIN=your-subdomain
DUCKDNS_TOKEN=YOUR_DUCKDNS_TOKEN_HERE
WAZUH_MANAGER_IP=192.168.2.10
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=YOUR_WAZUH_PASSWORD_HERE
