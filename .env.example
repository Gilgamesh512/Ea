# --- CẤU HÌNH WA-ZUH (Nằm bên VM) ---
# n8n sẽ dùng cái này để lấy alert từ Wazuh
WAZUH_MANAGER_IP=192.168.xx.xx  # Điền IP của con VM Wazuh vào đây
WAZUH_API_USER=admin
WAZUH_API_PASS=Gil_Secret_123

# --- CẤU HÌNH DEFECTDOJO ---
# n8n dùng cái này để đẩy kết quả scan (SAST/DAST) vào
DOJO_URL=http://defectdojo:8080
DOJO_API_KEY=your_dojo_token_here

# --- CẤU HÌNH OLLAMA ---
# n8n dùng cái này để hỏi AI giải thích lỗ hổng
OLLAMA_HOST=http://host.docker.internal:11434